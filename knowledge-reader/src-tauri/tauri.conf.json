{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feishu Wiki Reader",
  "version": "0.3.2",
  "identifier": "io.github.tangsyau.feishu-wiki-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "飞书知识库离线阅读器",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "离线浏览和搜索飞书知识库导出内容",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../NOTICE": "licenses/NOTICE",
      "../../src/FeishuExporter.Desktop/Assets/Fonts/OFL-1.1.txt": "licenses/NotoSansSC-OFL-1.1.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
